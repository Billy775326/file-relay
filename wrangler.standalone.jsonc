{
  // 仅用于本地构建：npm run build:single / npm run build:pages。
  // --dry-run 生成产物，不发布到 Cloudflare；前端资源已内联，无需 assets。
  // 生产资源与 Secrets 在控制台配置。操作步骤见 docs/deployment.md。
  "name": "file-relay-single",
  "main": "src/standalone.ts",
  "compatibility_date": "2025-06-01",

  // 占位 ID:本地 dev 用模拟 KV;单文件模式绑定在控制台手动加,不走本配置
  "kv_namespaces": [{ "binding": "fileKV", "id": "00000000000000000000000000000000" }]
}
