{
  "name": "file-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:limits": "node test/upload_limits.mjs",
    "test:quota": "node test/quota.mjs",
    "test:quota-runtime": "node test/quota_runtime.mjs",
    "dev": "wrangler dev",
    "dev:pages": "wrangler pages dev dist/pages --kv fileKV --port 8787",
    "deploy": "npm run build:pages && wrangler pages deploy dist/pages",
    "build:single": "node tools/gen-inline-assets.mjs && wrangler deploy -c wrangler.standalone.jsonc --dry-run --outdir=dist/_bundle && node tools/postbuild-single.mjs",
    "build:pages": "npm run build:single && node tools/build-pages.mjs",
    "db:local": "wrangler d1 execute file-relay --local --file=./schema/schema.sql",
    "db:remote": "wrangler d1 execute file-relay --remote --file=./schema/schema.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
