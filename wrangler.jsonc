{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "file-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // 本地开发配置：npm run dev。生产绑定请在 Cloudflare 项目设置中配置。
  // Pages 自动/手动部署、Workers 粘贴部署：见 docs/deployment.md。
  // 构建专用配置：wrangler.standalone.jsonc；不要用本文件直接发布 Workers。

  // 本地静态资源；管理页先进 Worker，以应用自定义入口规则。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin*"]
  },

  // 本地文件存储：默认 KV（25 MiB）；测试 R2 时取消下方注释。
  // "r2_buckets": [
  //   { "binding": "BUCKET", "bucket_name": "file-relay" }
  // ],

  // 本地元数据：默认 KV。占位 ID 仅用于本地模拟，无需访问生产命名空间。
  // 测试 D1：移除 kv_namespaces，启用下面 d1_databases，再运行 npm run db:local。
  "kv_namespaces": [
    { "binding": "fileKV", "id": "00000000000000000000000000000000" }
  ],

  // "d1_databases": [
  //   { "binding": "DB", "database_name": "file-relay", "database_id": "00000000-0000-0000-0000-000000000000" }
  // ],

  // 本地 scheduled 调试配置。Workers 生产定时器需在控制台单独添加；Pages 见部署指南。
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  // 本地普通变量；ADMIN_TOKEN 写入 .dev.vars（参见 .dev.vars.example）。
  // 生产默认值相同；如需覆盖，在项目 Variables and Secrets 中设置。
  "vars": {
    // 单个完整文件的上限(字节),含所有分片;10 GB,不是 10 GiB
    "MAX_FILE_SIZE": "10000000000",
    "MAX_TEXT_LENGTH": "65536",
    "PART_SIZE": "100000000",
    "SESSION_TTL_MS": "86400000",
    "MAX_PARTS": "10000"
  },

  "observability": { "enabled": true }
}
