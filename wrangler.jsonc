{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "file-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // 静态资源:命中文件直接由边缘返回,不进 Worker;/api/* 不匹配任何文件 → 落入 Worker
  // run_worker_first:/admin 与 /admin.html 必须先进 Worker,配合可选 secret ADMIN_PATH
  // 自定义管理入口(设置后 /admin 返回 404),防止绕过入口直取 admin.html
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin*"]
  },

  // ── 文件存储:默认小存储模式(KV 直传,单文件 ≤24MB,整个部署只需一个 KV 命名空间)──
  // 分享大文件为主时放开本块升级大存储模式(R2 分片,~2GB),免改代码:
  // "r2_buckets": [
  //   { "binding": "BUCKET", "bucket_name": "file-relay" }
  // ],

  // ── 元数据库:默认 KV(部署最简,免建 D1);D1 为可选强一致后端 ──
  // 切 D1 模式:注释掉 kv_namespaces、放开下面 d1_databases 即可,无需改代码。
  // 两者的语义差异/限额对比见 README「存储选型」。
  "kv_namespaces": [
    { "binding": "KV", "id": "4e267d205aef4957b1c2382a481ea882" }
  ],

  // "d1_databases": [
  //   { "binding": "DB", "database_name": "file-relay", "database_id": "<npx wrangler d1 create file-relay 的输出>" }
  // ],

  // 每 6 小时清理过期分享与孤儿分片会话(免费套餐支持)
  "triggers": {
    "crons": ["0 */6 * * *"]
  },

  // 非敏感配置走 vars;ADMIN_TOKEN 走 secret(npx wrangler secret put ADMIN_TOKEN)
  // 所有 var 都有代码兜底;PART_SIZE / SESSION_TTL_MS / MAX_PARTS 仅 R2 大存储模式用到,小存储(KV)模式可删
  "vars": {
    "MAX_FILE_SIZE": "2147483648",
    "MAX_TEXT_LENGTH": "65536",
    "PART_SIZE": "10485760",
    "SESSION_TTL_MS": "86400000",
    "MAX_PARTS": "10000"
  },

  "observability": { "enabled": true }
}
